{
  "name": "vsq-matching-game",
  "version": "1.0.0",
  "description": "Number-matching game for V Square Clinic, a single-page React app that runs offline on a touch-screen kiosk",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test e2e/offline.spec.ts e2e/reset.spec.ts e2e/countdown.spec.ts",
    "visual": "playwright test e2e/visual.spec.ts && .venv\\Scripts\\python.exe tools/compare_screens.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/surasak-kounloung/Matching-game.git"
  },
  "license": "UNLICENSED",
  "type": "module",
  "bugs": {
    "url": "https://github.com/surasak-kounloung/Matching-game/issues"
  },
  "homepage": "https://github.com/surasak-kounloung/Matching-game#readme",
  "dependencies": {
    "@fontsource/ibm-plex-sans-thai": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "private": true
}
